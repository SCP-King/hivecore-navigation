#!/usr/bin/env bash
# Canonical command router for N-01 repository workflows.
# Stable operator interface; focused scripts retain their own safety checks.
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
COMMAND="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

usage() {
  cat <<'EOF'
N-01 workflow command router

Usage:
  bash scripts/n01 <command> [arguments...]

Environment and read-only diagnostics:
  environment-preflight  Host, ROS, workspace and data-path check
  planning-audit         Collect planning readiness blockers
  live-preflight [SEC]   Read-only live ROS graph/freshness audit
  robot-pose-audit       Audit /robot_pose publisher endpoints and timing

Live planning lifecycle:
  navigation start|status|stop
  deploy                 Build and safely deploy N-01 live planning stack
  planning-smoke [ARGS]  READY-gated one-shot planning smoke test
  planning-acceptance    Goal-aware live planning acceptance; auto-stop stack

Offline validation (isolated ROS domain):
  g1-smoke               Short isolated G1 smoke test
  g1-acceptance          Full four-scenario G1 offline acceptance
  bag-functional         Historical Bag read-only functional replay
  offline-framework      Isolated N-01 framework pipeline
  g4-research            PCD/Bag free-space research workflow

Optional FAST-LIO2:
  fast-lio-import        Fetch pinned upstream source and apply local patch
  fast-lio-build         Build isolated FAST-LIO2 backend
  fast-lio-bag BAG [PCD]  Replay raw Livox Bag in private namespace

Demo and package-local research:
  demo-replay
  record-demo OUTPUT.mp4 [RVIZ_PID]
  fusion-min-loop
  fusion-phase-c
  fusion-bag-replay
  static-map-bag-replay

General:
  help                   Show this help

The router itself does not source vendor overlays or start hardware.
Read the repository README.md before operation. Offline PASS never authorizes
physical movement. All commands retain their own preflight and safety checks.
EOF
}

case "$COMMAND" in
  help|-h|--help) usage ;;
  environment-preflight) exec bash "$ROOT/scripts/n01_environment_preflight.sh" "$@" ;;
  planning-audit) exec bash "$ROOT/scripts/n01_collect_planning_readiness_audit.sh" "$@" ;;
  live-preflight) exec bash "$ROOT/scripts/run_n01_live_stack_preflight.sh" "$@" ;;
  robot-pose-audit) exec bash "$ROOT/scripts/run_n01_robot_pose_source_audit.sh" "$@" ;;
  navigation) exec bash "$ROOT/scripts/n01_navigation.sh" "$@" ;;
  deploy) exec bash "$ROOT/scripts/deploy_n01_planning_fixes.sh" "$@" ;;
  planning-smoke) exec bash "$ROOT/scripts/run_n01_planning_smoke_test.sh" "$@" ;;
  planning-acceptance) exec bash "$ROOT/scripts/run_n01_planning_acceptance.sh" "$@" ;;
  fast-lio-import) exec bash "$ROOT/scripts/import_n01_fast_lio2.sh" "$@" ;;
  fast-lio-build) exec bash "$ROOT/scripts/build_n01_fast_lio2.sh" "$@" ;;
  fast-lio-bag) exec bash "$ROOT/scripts/run_n01_fast_lio2_bag.sh" "$@" ;;
  g1-smoke) exec bash "$ROOT/scripts/run_g1_offline.sh" "$@" ;;
  g1-acceptance) exec bash "$ROOT/scripts/run_g1_acceptance.sh" "$@" ;;
  bag-functional) exec bash "$ROOT/scripts/run_n01_bag_functional.sh" "$@" ;;
  offline-framework) exec bash "$ROOT/scripts/run_n01_offline_framework.sh" "$@" ;;
  g4-research) exec bash "$ROOT/scripts/run_n01_g4_full_chain.sh" "$@" ;;
  demo-replay) exec bash "$ROOT/scripts/run_n01_demo_replay.sh" "$@" ;;
  record-demo) exec bash "$ROOT/scripts/record_n01_demo.sh" "$@" ;;
  fusion-min-loop) exec bash "$ROOT/src/n01_map_fusion/scripts/nav_min_loop.sh" "$@" ;;
  fusion-phase-c) exec bash "$ROOT/src/n01_map_fusion/scripts/nav_phase_c.sh" "$@" ;;
  fusion-bag-replay) exec bash "$ROOT/src/n01_map_fusion/scripts/replay_fusion_a_star.sh" "$@" ;;
  static-map-bag-replay) exec bash "$ROOT/src/n01_static_map/scripts/replay_nav_chain.sh" "$@" ;;
  *)
    echo "Unknown N-01 command: $COMMAND" >&2
    echo "Run 'bash scripts/n01 help' to list supported commands." >&2
    exit 2
    ;;
esac
