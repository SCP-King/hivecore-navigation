<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    SLAM / Nav 传感器帧（唯一定义处：hive2_description）。
    motion_dev / hive2_driver 的 robot_state_publisher 发布本文件定义的链路；
    autoNav 不再起独立 hivecore_robot_description RSP。

    URDF 输出（与 main 建图/定位节点契约对齐）:
      base_footprint → base_link → lidar_link
        - tracking_frame / Nav2 base: base_footprint
        - lidar_link: 水平投影参考帧（scan_frame；外参父帧）

    由 hivecore_lidar_slam3d static_tf_publisher 发布（不在 URDF，避免与 IMU 倾角标定抢写）:
      lidar_link → imu_link → livox_frame
        - imu_frame: imu_link
        - sensor_frame / Livox 原始点云: livox_frame

    完整链（运行时）:
      map → base_footprint          (lidar_3d_mapping / localization)
      base_footprint → base_link    (本 URDF / hive2_driver RSP)
      base_link → lidar_link        (本 URDF / hive2_driver RSP)
      lidar_link → imu_link         (static_tf_publisher)
      imu_link → livox_frame        (static_tf_publisher)

    已有 world→base_link 的整机（R1）: base_link → base_footprint（子帧）+ base_link → lidar_link
  -->

  <!-- 平台默认外参（改标定只改这里；lidar xyz/rpy 对齐 main hivecore_robot.urdf.xacro） -->
  <xacro:property name="hive2_footprint_xyz" value="0 0 0.90"/>
  <xacro:property name="hive2_lidar_xyz" value="0.295 0 0"/>
  <xacro:property name="hive2_lidar_rpy" value="0 0 0"/>

  <xacro:property name="hive3_footprint_xyz" value="0 0 0.60"/>
  <xacro:property name="hive3_lidar_xyz" value="0.295 0 0"/>
  <xacro:property name="hive3_lidar_rpy" value="0 0 0"/>

  <xacro:macro name="hivecore_base_footprint_link">
    <link name="base_footprint"/>
  </xacro:macro>

  <!-- Nav2 / SLAM 标准：footprint 为 base 父帧（main tracking_frame） -->
  <xacro:macro name="hivecore_footprint_to_base_link_joint" params="footprint_xyz">
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="${footprint_xyz}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!--
    lidar_link: main scan_frame / 水平投影帧。
    与 static_tf 的 lidar_imu.parent_frame、preprocess scan_frame 同名。
  -->
  <xacro:macro name="hivecore_lidar_mount" params="lidar_xyz lidar_rpy">
    <link name="lidar_link"/>
    <joint name="lidar_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="${lidar_xyz}" rpy="${lidar_rpy}"/>
    </joint>
  </xacro:macro>

  <!--
    已有 base_link（如 hive1 world→base）时挂传感器：
    footprint 只能作子帧，不能再当 base 父（URDF 单亲）。
  -->
  <xacro:macro name="hivecore_sensor_frames_on_existing_base"
    params="footprint_xyz:='0 0 0.90' lidar_xyz:='0.295 0 0' lidar_rpy:='0 0 0'">
    <xacro:hivecore_base_footprint_link/>
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_link"/>
      <child link="base_footprint"/>
      <origin xyz="${footprint_xyz}" rpy="0 0 0"/>
    </joint>
    <xacro:hivecore_lidar_mount lidar_xyz="${lidar_xyz}" lidar_rpy="${lidar_rpy}"/>
  </xacro:macro>
</robot>
