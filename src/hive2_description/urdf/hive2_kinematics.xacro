<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Hive2 运动学（CAD mesh + 控制栈命名）。

    几何/惯性：来自 SolidWorks 导出（见 urdf/cad/），meshes 在 meshes/*.STL。
    关节/链接命名：fl/fr/rl/rr + pitch1/pitch2/ankle_yaw/wheel_*（与 leg/wheel 控制一致）。
    轴向：统一为 pitch 0 1 0、ankle yaw 0 0 1、wheel 0 1 0（便于控制；CAD 左右轴符号已归一）。

    CAD 链长：髋→膝 0.3725 m；膝→踝 0.4325 m；踝→轮心 0.0485 m。
    安装：前 ±0.3049 m，后 -0.2451 m；左右 ±0.1426 m。

    KDL：base_link → *_hip_link → *_thigh_link → *_foot_link（fixed 绕过 ankle_yaw）。
  -->

  <xacro:macro name="hive2_mesh_link"
    params="name mesh_file mass xyz ixx ixy ixz iyy iyz izz material_rgba:='0.75 0.78 0.85 1'">
    <link name="${name}">
      <inertial>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hive2_description/meshes/${mesh_file}"/>
        </geometry>
        <material name="${name}_mat">
          <color rgba="${material_rgba}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hive2_description/meshes/${mesh_file}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!--
    prefix: fl | fr | rl | rr
    bx, by：hip 相对 base_link
    左右惯性用 side=+1(左) / -1(右) 镜像 CAD 值
  -->
  <xacro:macro name="hive2_leg_branch" params="prefix bx by side wheel_joint_name">
    <xacro:property name="femur_len" value="0.3725"/>
    <xacro:property name="tibia_len" value="0.4325"/>
    <xacro:property name="below_ankle_len" value="0.0485"/>

    <!-- 大腿（CAD: *_hip_pitch_link） -->
    <xacro:hive2_mesh_link
      name="${prefix}_hip_link"
      mesh_file="${prefix}_hip_link.STL"
      mass="1.44012191573"
      xyz="0 ${side * 0.03915098778} -0.17233199454"
      ixx="0.03606061474" ixy="${side * 3.6894e-08}" ixz="${side * -3.03594e-07}"
      iyy="0.03924767865" iyz="${side * 0.00049789303}" izz="0.00426417793"
      material_rgba="0.91 0.58 0.82 1"/>
    <joint name="${prefix}_leg_pitch1" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_hip_link"/>
      <origin xyz="${bx} ${by} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- 力矩上限沿用旧模型标定 120 N·m -->
      <limit lower="-0.7854" upper="1.48" effort="120" velocity="2.8"/>
    </joint>

    <!-- 小腿（CAD: *_knee_pitch_link；link 名 thigh_link 兼容 SRDF） -->
    <xacro:hive2_mesh_link
      name="${prefix}_thigh_link"
      mesh_file="${prefix}_thigh_link.STL"
      mass="1.45019155137"
      xyz="0 ${side * 0.05373873959} -0.20067405144"
      ixx="0.01901496678" ixy="${side * 6.39e-10}" ixz="${side * 1.04045e-08}"
      iyy="0.02044797831" iyz="${side * -0.00048439547}" izz="0.00174350657"
      material_rgba="0.70 0.75 0.90 1"/>
    <joint name="${prefix}_leg_pitch2" type="revolute">
      <parent link="${prefix}_hip_link"/>
      <child link="${prefix}_thigh_link"/>
      <origin xyz="0 0 ${-femur_len}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.65" upper="1.65" effort="120" velocity="2.8"/>
    </joint>

    <!-- 踝 yaw（CAD: *_ankle_yaw_link） -->
    <xacro:hive2_mesh_link
      name="${prefix}_shank_link"
      mesh_file="${prefix}_shank_link.STL"
      mass="0.16178780858"
      xyz="${side * -0.00027131474} ${side * 0.03638242743} -0.02611601965"
      ixx="0.00015215130" ixy="${side * 6.41213e-07}" ixz="${side * -9.88613e-08}"
      iyy="0.00014363228" iyz="${side * 4.30284e-05}" izz="0.00013643245"
      material_rgba="0.60 0.70 0.80 1"/>
    <joint name="${prefix}_ankle_yaw" type="revolute">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_shank_link"/>
      <origin xyz="0 0 ${-tibia_len}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.5708" upper="1.5708" effort="50" velocity="3.14"/>
    </joint>

    <!-- KDL 足端代理：绕过 ankle_yaw，仅 pitch1/pitch2 -->
    <link name="${prefix}_foot_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="${prefix}_kdl_foot_fixed" type="fixed">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_foot_link"/>
      <origin xyz="0 0 ${-(tibia_len + below_ankle_len)}" rpy="0 0 0"/>
    </joint>

    <!-- 轮（CAD: *_wheel_link） -->
    <xacro:hive2_mesh_link
      name="${prefix}_wheel_link"
      mesh_file="${prefix}_wheel_link.STL"
      mass="1.160598"
      xyz="0 ${side * 0.08180671} 0"
      ixx="0.002739345" ixy="${side * 2.6408e-06}" ixz="0"
      iyy="0.005018372" iyz="${side * 4.8175e-06}" izz="0.002739032"
      material_rgba="0.20 0.20 0.22 1"/>
    <joint name="${wheel_joint_name}" type="continuous">
      <parent link="${prefix}_shank_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 ${-below_ankle_len}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="hive2_kinematics" params="root_mode:='world' footprint_xyz:='0 0 0.90' lidar_xyz:='0.295 0 0' lidar_rpy:='0 0 0'">
    <xacro:if value="${root_mode == 'base_footprint'}">
      <xacro:include filename="$(find hive2_description)/urdf/hivecore_sensor_frames.xacro"/>
      <xacro:hivecore_base_footprint_link/>
    </xacro:if>
    <xacro:unless value="${root_mode == 'base_footprint'}">
      <link name="world"/>
    </xacro:unless>

    <xacro:hive2_mesh_link
      name="base_link"
      mesh_file="base_link.STL"
      mass="13.2958901606"
      xyz="0.03365496526 -0.00010908309 0.00519820255"
      ixx="0.08871346216" ixy="1.2429e-06" ixz="-3.5085e-06"
      iyy="0.10190777933" iyz="1.7628e-05" izz="0.12617374156"
      material_rgba="0.79 0.82 0.93 1"/>

    <xacro:if value="${root_mode == 'base_footprint'}">
      <xacro:hivecore_footprint_to_base_link_joint footprint_xyz="${footprint_xyz}"/>
      <xacro:hivecore_lidar_mount lidar_xyz="${lidar_xyz}" lidar_rpy="${lidar_rpy}"/>
    </xacro:if>
    <xacro:unless value="${root_mode == 'base_footprint'}">
      <joint name="world_to_base" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:unless>

    <!-- CAD 安装位：前 x=0.3049，后 x=-0.2451，左右 |y|=0.1426 -->
    <xacro:hive2_leg_branch prefix="fl" bx="0.3049" by="0.1426"  side="1"  wheel_joint_name="wheel_fl"/>
    <xacro:hive2_leg_branch prefix="fr" bx="0.3049" by="-0.1426" side="-1" wheel_joint_name="wheel_fr"/>
    <xacro:hive2_leg_branch prefix="rl" bx="-0.2451" by="0.1426"  side="1"  wheel_joint_name="wheel_rl"/>
    <xacro:hive2_leg_branch prefix="rr" bx="-0.2451" by="-0.1426" side="-1" wheel_joint_name="wheel_rr"/>
  </xacro:macro>
</robot>
