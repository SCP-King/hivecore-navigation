Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.3
      Class: rviz_default_plugins/Grid
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid 1m (Ground z=0, odom)
      Plane Cell Count: 40
      Plane Cell Size: 1
      Reference Frame: odom
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Local PCD (真实局部点云)
      Size (Pixels): 2
      Style: Points
      Color Transformer: FlatColor
      Color: 200; 200; 200
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_pcd
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: SCAN Occupancy (占用栅格·红)
      Size (Pixels): 4
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /grid_map/occupancy
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: SCAN Inflate (膨胀·橙)
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 160; 40
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /grid_map/occupancy_inflate
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: CBF Ellipse (关闭)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ellipse_vis
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Obstacle Pred (关闭)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /obs_predict_vis_pub
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: Global Path (关闭)
      Color: 255; 153; 26
      Line Style:
        Line Width: 0.03
        Value: Lines
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /global_path
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: Local Path (关闭)
      Color: 0; 230; 51
      Line Style:
        Line Width: 0.04
        Value: Lines
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_path
    - Class: rviz_default_plugins/RobotModel
      Enabled: false
      Name: Robot (关闭)
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      TF Prefix: ""
      Update Interval: 0
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF (关闭)
      Show Arrows: true
      Show Axes: true
      Show Names: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /move_base_simple/goal
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Enable Stereo Rendering:
        Stereo Eye Rotation: 0
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
      Focal Point:
        X: 0
        Y: 0
        Z: 0.3
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.2
      Target Frame: odom
      Value: Orbit
      Yaw: 3.1416
