Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.3
      Class: rviz_default_plugins/Grid
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid 1m (odom)
      Plane Cell Count: 40
      Plane Cell Size: 1
      Reference Frame: odom
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Footprint (青色实线=车体 灰虚线=安全轮廓)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /footprint_vis
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: SCAN Occupancy (占用栅格·红)
      Size (Pixels): 5
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /grid_map/occupancy
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: SCAN Inflate (膨胀·橙, 默认关)
      Size (Pixels): 4
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 160; 40
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /grid_map/occupancy_inflate
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Local PCD (环境点云·默认关)
      Size (Pixels): 2
      Style: Points
      Color Transformer: FlatColor
      Color: 200; 200; 200
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_pcd
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: CBF Ellipse (关闭)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ellipse_vis
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Obstacle Pred (关闭)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /obs_predict_vis_pub
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: Global Path (规划未跑·关)
      Color: 255; 153; 26
      Line Style:
        Line Width: 0.03
        Value: Lines
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /global_path
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: Local Path (规划未跑·关)
      Color: 0; 230; 51
      Line Style:
        Line Width: 0.04
        Value: Lines
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_path
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description_viz
      Name: Robot (乙方独立Hive2模型·24link·关跳变)
      TF Prefix: viz_
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF (双RSP分裂·关)
      Show Arrows: true
      Show Axes: true
      Show Names: false
  Enabled: true
  Global Options:
    Background Color: 46; 46; 46
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /move_base_simple/goal
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Rotation: 0
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: SCAN 俯视（跟随机器人）
      Near Clip Distance: 0.01
      Target Frame: viz_base_link
      Value: TopDownOrtho
      X: 0
      Y: 0
      Zoom: 4.0