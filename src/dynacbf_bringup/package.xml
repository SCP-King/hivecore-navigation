<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dynacbf_bringup</name>
  <version>0.1.0</version>
  <description>
    hivecore-navigation 的 bring-up 包：只包含跨包编排 launch 与真机覆盖参数。
    负责把感知、跟踪、规划器（栅格 → A* → B 样条）、MPC-D-CBF 控制器与
    定位就绪门控（dynacbf_gate）编排成一条面向 HiveCore 真机的导航链路，
    不依赖任何仿真组件。
  </description>
  <maintainer email="NuoDaJia02@hivecore.cn">NuoDaJia02</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- launch 文件本身依赖 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- 被本包 launch 编排的节点所在包。上述每个包的可执行文件都已构建并在闭环中启动过。 -->
  <exec_depend>dynacbf_perception</exec_depend>
  <exec_depend>dynacbf_tracking</exec_depend>
  <exec_depend>dynacbf_planner</exec_depend>
  <exec_depend>dynacbf_dcbf</exec_depend>
  <!-- 定位就绪门控节点 -->
  <exec_depend>dynacbf_gate</exec_depend>

  <!-- 消息包：RViz 显示插件在运行期需要能加载这些类型的自描述消息 -->
  <exec_depend>dynacbf_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <!-- 可视化与坐标系 -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
